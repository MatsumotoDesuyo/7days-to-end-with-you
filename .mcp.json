{
  "mcpServers": {
    "grafana-ro": {
      "command": "mcp-grafana",
      "args": ["-t", "stdio", "--disable-write"],
      "env": {
        "GRAFANA_URL": "https://maroonkinkajou2355.grafana.net",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_VIEWER_TOKEN}"
      }
    },
    "sentry-ro": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp?skills=inspect",
      "headers": {
        "Authorization": "Sentry-Bearer ${SENTRY_VIEWER_TOKEN}"
      }
    }
  }
}
